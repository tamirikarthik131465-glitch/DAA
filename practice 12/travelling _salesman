def tsp(graph, n):
    dp = [[float('inf')] * n for _ in range(1 << n)]
    dp[1][0] = 0

    for mask in range(1 << n):
        for u in range(n):
            if mask & (1 << u):
                for v in range(n):
                    if not mask & (1 << v):
                        new_mask = mask | (1 << v)
                        dp[new_mask][v] = min(
                            dp[new_mask][v],
                            dp[mask][u] + graph[u][v]
                        )

    ans = float('inf')
    for i in range(n):
        ans = min(ans, dp[(1 << n) - 1][i] + graph[i][0])

    return ans


n = int(input("Enter number of cities: "))

graph = []
print("Enter cost matrix:")

for i in range(n):
    graph.append(list(map(int, input().split())))

print("Minimum travelling cost:", tsp(graph, n))
